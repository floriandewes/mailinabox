#, python-format
msgid ""
"Connection to dbl.spamhaus.org timed out. Could not determine whether the"
" domain %(domain)s is blacklisted. Please try again later."
msgstr ""
"Time-out bij verbinding met dbl.spamhaus.org. Kon niet bepalen of het "
"domein %(domain)s op de zwarte lijst staat. Probeer het later opnieuw."

#. Status: mt
#. Phase: 1
#: status_checks.py:814
#, python-format
msgid ""
"Could not connect to dbl.spamhaus.org. Could not determine whether the "
"domain %(domain)s is blacklisted. Please try again later."
msgstr ""
"Kon geen verbinding maken met dbl.spamhaus.org. Kon niet bepalen of het "
"domein %(domain)s op de zwarte lijst staat. Probeer het later opnieuw."

#. Status: mt
#. Phase: 1
#: status_checks.py:816
#, python-format
msgid ""
"Incorrect spamhaus query: %(query)s. Could not determine whether the "
"domain %(domain)s is blacklisted."
msgstr ""
"Onjuiste spamhaus-query: %(query)s. Kon niet bepalen of het domein "
"%(domain)s op de zwarte lijst staat."

#. Status: mt
#. Phase: 1
#: status_checks.py:818
#, python-format
msgid ""
"Trixie Mail is configured to use a public DNS server. This is not "
"supported by spamhaus. Could not determine whether the domain %(domain)s "
"is blacklisted."
msgstr ""
"Trixie Mail is geconfigureerd om een openbare DNS-server te gebruiken. "
"Dit wordt niet ondersteund door spamhaus. Kon niet bepalen of het domein "
"%(domain)s op de zwarte lijst staat."

#. Status: mt
#. Phase: 1
#: status_checks.py:820
#, python-format
msgid ""
"Too many queries have been performed on the spamhaus server. Could not "
"determine whether the domain %(domain)s is blacklisted."
msgstr ""
"Er zijn te veel query's uitgevoerd op de spamhaus-server. Kon niet "
"bepalen of het domein %(domain)s op de zwarte lijst staat."

#. Status: mt
#. Phase: 1
#: status_checks.py:822
#, python-format
msgid ""
"This domain is listed in the Spamhaus Domain Block List (code %(code)s),\n"
"\t\t\twhich may prevent recipients from receiving your mail.\n"
"\t\t\tSee http://www.spamhaus.org/dbl/ and "
"http://www.spamhaus.org/query/domain/%(domain)s."
msgstr ""
"Dit domein staat op de Spamhaus Domain Block List (code %(code)s),\n"
"\t\t\twat ontvangers kan verhinderen uw e-mail te ontvangen.\n"
"\t\t\tZie http://www.spamhaus.org/dbl/ en "
"http://www.spamhaus.org/query/domain/%(domain)s."

#. Status: mt
#. Phase: 1
#: status_checks.py:838
#, python-format
msgid ""
"This domain should resolve to this box's IP address (%(rtype)s "
"%(expected)s) if you would like the box to serve\n"
"\t\t\t\t\twebmail or a website on this domain. The domain currently "
"resolves to %(value)s in public DNS. It may take several hours for\n"
"\t\t\t\t\tpublic DNS to update after a change. This problem may result "
"from other issues listed here."
msgstr ""
"Dit domein zou naar het IP-adres van dit systeem (%(rtype)s %(expected)s)"
" moeten oplossen als u wilt dat het systeem\n"
"\t\t\t\t\twebmail of een website op dit domein aanbiedt. Het domein lost "
"momenteel op naar %(value)s in openbare DNS. Het kan enkele uren duren "
"voordat\n"
"\t\t\t\t\topenbare DNS na een wijziging is bijgewerkt. Dit probleem kan "
"voortkomen uit andere hier vermelde problemen."

#. Status: mt
#. Phase: 1
#: status_checks.py:844
#, python-format
msgid "Domain resolves to this box's IP address. [%(domain)s ↦ %(ips)s]"
msgstr "Domein lost op naar het IP-adres van dit systeem. [%(domain)s ↦ %(ips)s]"

#. Status: mt
#. Phase: 1
#: status_checks.py:912
msgid ""
"No TLS (SSL) certificate is installed for this domain. Visitors to a "
"website on\n"
"\t\t\tthis domain will get a security warning. If you are not serving a "
"website on this domain, you do\n"
"\t\t\tnot need to take any action. Use the TLS Certificates page in the "
"control panel to install a\n"
"\t\t\tTLS certificate."
msgstr ""
"Er is geen TLS-(SSL-)certificaat geïnstalleerd voor dit domein. Bezoekers"
" van een website op\n"
"\t\t\tdit domein krijgen een beveiligingswaarschuwing. Als u geen website"
" op dit domein aanbiedt, hoeft u\n"
"\t\t\tniet te handelen. Gebruik de pagina TLS-certificaten in het "
"controlepaneel om een\n"
"\t\t\tTLS-certificaat te installeren."

