msgstr "CAA (Autorizzazione Autorità di certificazione)"

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:37
msgid ""
"Enter another domain name followed by a period at the end (e.g. "
"mypage.github.io.)."
msgstr ""
"Inserisci un altro nome di dominio seguito da un periodo alla fine (ad "
"esempio mypage.github.io.)."

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:37
