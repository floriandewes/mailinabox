#. Status: mt
#. Phase: 1
#: locale/js_messages.py:107
msgid ""
"<p class='text-danger'>If you change your own password, you will be "
"logged out of this control panel and will need to log in again.</p>"
msgstr ""
"<p class='text-danger'>Se cambi la tua password, sarai registrato da "
"questo pannello di controllo e dovrai registrarti di nuovo.</p>"

#. Status: mt
#. Phase: 1
#: locale/js_messages.py:108
#, python-format
msgid ""
"<p>Set a new password for <b>%(email)s</b>?</p> <p><label "
"for='users_set_password_pw' style='display: block; font-weight: "
"normal'>New Password:</label><input type='password' "
"id='users_set_password_pw'></p><p><small>Passwords must be at least eight"
" characters and may not contain spaces.</small>%(yourpw)s</p>"
msgstr ""
"<p>Impostare una nuova password per <b>%(email)s</b>?</p> <p><label "
"for='users_set_password_pw' style='display: block; font-weight: "
"normal'>Nuova password:</label><input type='password' "
"id='users_set_password_pw'></p><p><small>Le password devono avere almeno "
"otto caratteri e non possono contenere spazi.</small>%(yourpw)s</p>"

#. Status: mt
#. Phase: 1
#: locale/js_messages.py:109 templates/users.html:74
msgid "Set Quota"
msgstr "Set Quota"

#. Status: mt
#. Phase: 1
#: locale/js_messages.py:110
#, python-format
msgid ""
"<p>Set quota for <b>%(email)s</b>?</p><p><label for='users_set_quota' "
"style='display: block; font-weight: normal'>Quota:</label><input "
"type='text' id='users_set_quota' value='%(quota)s'></p><p><small>Quotas "
"may not contain any spaces or commas.  Suffixes of G (gigabytes) and M "
"(megabytes) are allowed.</small></p><p><small>For unlimited storage enter"
" 0 (zero)</small></p>"
msgstr ""
"<p>Impostare la quota per <b>%(email)s</b>?</p><p><label "
"for='users_set_quota' style='display: block; font-weight: "
"normal'>Quota:</label><input type='text' id='users_set_quota' "
"value='%(quota)s'></p><p><small>Le quote non possono contenere spazi o "
"virgole. Sono ammessi i suffissi G (gigabyte) e M "
"(megabyte).</small></p><p><small>Per spazio illimitato inserire 0 "
"(zero)</small></p>"

