#. Status: mt
#. Phase: 1
#: mailconfig.py:578
msgid "The alias must either forward to an address or have a permitted sender."
msgstr "L'alias deve inoltrare a un indirizzo oppure avere un mittente consentito."

#. Status: mt
#. Phase: 1
#: mailconfig.py:592
#, python-format
msgid "Alias already exists (%(address)s)."
msgstr "L'alias esiste già (%(address)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:611
#, python-format
msgid "That's not an alias (%(address)s)."
msgstr "Questo non è un alias (%(address)s)."

