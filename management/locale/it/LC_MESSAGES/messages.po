#: templates/users.html:53 templates/web.html:28
msgid "Actions"
msgstr "Azioni"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:107
msgid ""
"hostmaster@, postmaster@, admin@ and abuse@ email addresses are required "
"on some domains."
msgstr ""
"hostmaster@, postmaster@, admin@ e indirizzi email abuse@ sono richiesti "
"su alcuni domini."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:113
msgid "Edit Alias"
msgstr "Modifica Alias"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:127
msgid "Mail aliases API (advanced)"
msgstr "Mail aliases API (avanzato)"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:129
msgid ""
"Use your box&rsquo;s mail aliases API to add and remove mail aliases from"
" the command-line or custom services you build."
msgstr ""
"Utilizzare la tua casella&rsquo;s mail aliases API per aggiungere e "
"rimuovere gli alias di posta dalla riga di comando o servizi "
"personalizzati che si costruisce."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:131 templates/custom-dns.html:113
#: templates/users.html:107
msgid "Usage:"
msgstr "Utilizzo:"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:135 templates/users.html:111
msgid ""
"Brackets denote an optional argument. Please note that the POST body "
"<code>parameters</code> must be URL-encoded."
msgstr ""
"I bracchetti denotano un argomento facoltativo. Si prega di notare che il"
" corpo POST <code>parameters</code> deve essere codificato URL."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:137 templates/users.html:113
msgid ""
"The email and password given to the <code>--user</code> option must be an"
" administrative user on this system."
msgstr ""
"L'email e la password data all'opzione ⟦T0----user</code> devono essere "
"un utente amministrativo su questo sistema."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:139 templates/custom-dns.html:119
#: templates/users.html:115
msgid "Verbs"
msgstr "Verbi"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:143 templates/custom-dns.html:123
#: templates/users.html:118
msgid "Verb"
msgstr "Verbale"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:143 templates/users.html:118
msgid "Action"
msgstr "Azione"

