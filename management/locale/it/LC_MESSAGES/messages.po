msgstr "Indirizzo e-mail del destinatario non valido (%(email)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:558
msgid ""
"This alias can only have administrators of this system as destinations "
"because the address is frequently used for domain control validation."
msgstr ""
"Questo alias può avere come destinazioni solo gli amministratori di "
"questo sistema perché l'indirizzo è spesso usato per la convalida del "
"controllo del dominio."

#. Status: mt
#. Phase: 1
#: mailconfig.py:573
