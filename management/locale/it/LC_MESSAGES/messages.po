#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:39
msgid "MX (mail exchanger)"
msgstr "MX (scambio di posta)"

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:40
msgid ""
"Enter record in the form of PRIORITY WEIGHT PORT TARGET., including "
"trailing period (e.g. 10 10 5060 sip.example.com.)."
msgstr ""
"Immettere record sotto forma di TARGET di PORTO DI PRIORITÀ., compreso il"
" periodo di trailing (ad esempio 10 10 10 5060 sip.example.com.)."

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:40
msgid "SRV (service record)"
msgstr "SRV (registratore di servizio)"

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:41
msgid "Enter record in the form of ALGORITHM TYPE FINGERPRINT."
msgstr "Immettere record sotto forma di ALGORITHM TYPE FINGERPRINT."

#. Status: mt
#. Phase: 1
#: templates/custom-dns.html:41
msgid "SSHFP (SSH fingerprint record)"
msgstr "SSHFP (SSH impronte digitali)"

#. Status: mt
#. Phase: 1
