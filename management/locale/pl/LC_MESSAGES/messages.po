msgstr "Nieprawidłowy typ MFA."

#. Status: mt
#. Phase: 1
#: mfa.py:73
msgid "No secret provided."
msgstr "Nie podano sekretu."

#. Status: mt
#. Phase: 1
#: mfa.py:76
