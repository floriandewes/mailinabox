"%(ns_ips)s. Aktualizacja\n"
"\t\t\tpublicznego DNS po zmianie może potrwać kilka godzin."

#. Status: mt
#. Phase: 1
#: status_checks.py:491
#, python-format
msgid "Domain resolves to box's IP address. [%(host)s ↦ %(ips)s]"
msgstr "Domena wskazuje na adres IP systemu. [%(host)s ↦ %(ips)s]"

