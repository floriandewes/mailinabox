msgstr "Wolna pamięć systemu wynosi co najmniej %(pct)s%%."

#. Status: mt
#. Phase: 1
#: status_checks.py:260 status_checks.py:263
#, python-format
msgid "System free memory is below %(pct)s%%."
msgstr "Wolna pamięć systemu jest poniżej %(pct)s%%."

#. Status: mt
#. Phase: 1
#: status_checks.py:273
