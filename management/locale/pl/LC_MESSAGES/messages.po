#, python-format
msgid ""
"%(name)s is running (and available over IPv4 and the local IPv6 address),"
" but it is not publicly accessible at %(ip)s:%(port)d."
msgstr ""
"%(name)s działa (i jest dostępny przez IPv4 oraz lokalny adres IPv6), ale"
" nie jest publicznie dostępny pod %(ip)s:%(port)d."

#. Status: mt
#. Phase: 1
#: status_checks.py:130
