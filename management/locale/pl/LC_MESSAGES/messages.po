"\t\t \thttp://www.spamhaus.org/query/ip/%(addr)s."
msgstr ""
"Adres %(type)s tej maszyny %(addr)s znajduje się na Spamhaus Block\n"
"\t\t \tList (kod %(code)s), co może uniemożliwić odbiorcom otrzymanie "
"Twojej poczty. Zobacz\n"
"\t\t \thttp://www.spamhaus.org/query/ip/%(addr)s."

#. Status: mt
#. Phase: 1
#: status_checks.py:418
#, python-format
msgid "Domain name is invalid: %(err)s"
msgstr "Nazwa domeny jest nieprawidłowa: %(err)s"

#. Status: mt
#. Phase: 1
#: status_checks.py:475
#, python-format
msgid ""
"Nameserver glue records are correct at registrar. [ns1/ns2.%(host)s ↦ "
"%(ip)s]"
msgstr ""
"Rekordy glue serwerów nazw są poprawne u rejestratora. [ns1/ns2.%(host)s "
"↦ %(ip)s]"

