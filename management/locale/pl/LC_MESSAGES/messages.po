msgstr "Dysk ma więcej niż %(pct)s%% wolnego miejsca."

#. Status: mt
#. Phase: 1
#: status_checks.py:235 status_checks.py:238
#, python-format
msgid "The disk has less than %(pct)s%% free space."
msgstr "Dysk ma mniej niż %(pct)s%% wolnego miejsca."

#. Status: mt
#. Phase: 1
#: status_checks.py:250
#, python-format
