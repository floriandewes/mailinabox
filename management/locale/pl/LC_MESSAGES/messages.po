msgstr "Plik klucza prywatnego %(path)s nie jest plikiem klucza prywatnego."

#. Status: mt
#. Phase: 1
#: ssl_certificates.py:568
#, python-format
msgid "The certificate does not correspond to the private key at %(path)s."
msgstr "Certyfikat nie odpowiada kluczowi prywatnemu w %(path)s."

#. Status: mt
#. Phase: 1
#: ssl_certificates.py:590
#, python-format
msgid ""
"The certificate has expired or is not yet valid. It is valid from "
