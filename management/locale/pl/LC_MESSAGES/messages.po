#. Status: mt
#. Phase: 1
#: mailconfig.py:317 mailconfig.py:522
msgid "No email address provided."
msgstr "Nie podano adresu e-mail."

#. Status: mt
#. Phase: 1
#: mailconfig.py:319
msgid "Invalid email address."
msgstr "Nieprawidłowy adres e-mail."

#. Status: mt
#. Phase: 1
#: mailconfig.py:321
msgid ""
"User account email addresses may only use the lowercase ASCII letters "
"a-z, the digits 0-9, underscore (_), hyphen (-), and period (.)."
msgstr ""
"Adresy e-mail kont użytkowników mogą używać tylko małych liter ASCII a-z,"
" cyfr 0-9, podkreślenia (_), łącznika (-) i kropki (.)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:326
msgid ""
"You may not make a user account for that address because it is frequently"
" used for domain control validation. Use an alias instead if necessary."
msgstr ""
"Nie możesz utworzyć konta użytkownika dla tego adresu, ponieważ jest on "
"często używany do weryfikacji kontroli domeny. W razie potrzeby użyj "
"aliasu."

#. Status: mt
#. Phase: 1
#: mailconfig.py:359
msgid "User already exists."
msgstr "Użytkownik już istnieje."

#. Status: mt
#. Phase: 1
#: mailconfig.py:380 mailconfig.py:396 mailconfig.py:409 mailconfig.py:451
#: mailconfig.py:460 mailconfig.py:476
#, python-format
msgid "That's not a user (%(email)s)."
msgstr "To nie jest użytkownik (%(email)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:431
msgid "No quota provided."
msgstr "Nie podano limitu."

#. Status: mt
#. Phase: 1
#: mailconfig.py:434
msgid "Quotas cannot contain spaces, commas, or decimal points."
msgstr "Limity nie mogą zawierać spacji, przecinków ani kropek dziesiętnych."

#. Status: mt
#. Phase: 1
#: mailconfig.py:437
msgid "Invalid quota."
msgstr "Nieprawidłowy limit."

#. Status: mt
#. Phase: 1
#: mailconfig.py:481
#, python-format
msgid "That's not a valid privilege (%(priv)s)."
msgstr "To nie jest prawidłowe uprawnienie (%(priv)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:500
msgid "Invalid action."
msgstr "Nieprawidłowa akcja."

#. Status: mt
#. Phase: 1
#: mailconfig.py:506
msgid "Something went wrong."
msgstr "Coś poszło nie tak."

#. Status: mt
#. Phase: 1
#: mailconfig.py:524
#, python-format
msgid "Invalid email address (%(address)s)."
msgstr "Nieprawidłowy adres e-mail (%(address)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:553
#, python-format
msgid "Invalid receiver email address (%(email)s)."
msgstr "Nieprawidłowy adres e-mail odbiorcy (%(email)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:558
msgid ""
"This alias can only have administrators of this system as destinations "
"because the address is frequently used for domain control validation."
msgstr ""
"Ten alias może mieć jako cele tylko administratorów tego systemu, "
"ponieważ adres jest często używany do weryfikacji kontroli domeny."

#. Status: mt
#. Phase: 1
#: mailconfig.py:573
#, python-format
msgid "Invalid permitted sender: %(login)s is not a user on this system."
msgstr ""
"Nieprawidłowy dozwolony nadawca: %(login)s nie jest użytkownikiem tego "
"systemu."

#. Status: mt
#. Phase: 1
#: mailconfig.py:578
msgid "The alias must either forward to an address or have a permitted sender."
msgstr "Alias musi przekazywać na adres lub mieć dozwolonego nadawcę."

#. Status: mt
#. Phase: 1
#: mailconfig.py:592
#, python-format
msgid "Alias already exists (%(address)s)."
msgstr "Alias już istnieje (%(address)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:611
#, python-format
msgid "That's not an alias (%(address)s)."
msgstr "To nie jest alias (%(address)s)."

#. Status: mt
#. Phase: 1
#: mailconfig.py:713
msgid "No password provided."
msgstr "Nie podano hasła."

#. Status: mt
#. Phase: 1
#: mailconfig.py:716
msgid "Passwords must be at least eight characters."
msgstr "Hasła muszą mieć co najmniej osiem znaków."

