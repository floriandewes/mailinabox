msgstr "Jest %d pakietów oprogramowania, które można zaktualizować."

#. Status: mt
#. Phase: 1
#: status_checks.py:223
msgid "System administrator address"
msgstr "Adres administratora systemu"

#. Status: mt
#. Phase: 1
#: status_checks.py:230
#, python-format
