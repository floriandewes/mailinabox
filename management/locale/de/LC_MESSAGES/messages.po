"<p>Neues Passwort für <b>%(email)s</b> festlegen?</p> <p><label "
"for='users_set_password_pw' style='display: block; font-weight: "
"normal'>Neues Passwort:</label><input type='password' "
"id='users_set_password_pw'></p><p><small>Passwörter müssen mindestens "
"acht Zeichen lang sein und dürfen keine Leerzeichen "
"enthalten.</small>%(yourpw)s</p>"

#. Status: mt
#. Phase: 1
#: locale/js_messages.py:109 templates/users.html:74
msgid "Set Quota"
msgstr "Quote festgesetzt"

#. Status: mt
#. Phase: 1
#: locale/js_messages.py:110
#, python-format
msgid ""
"<p>Set quota for <b>%(email)s</b>?</p><p><label for='users_set_quota' "
"style='display: block; font-weight: normal'>Quota:</label><input "
"type='text' id='users_set_quota' value='%(quota)s'></p><p><small>Quotas "
"may not contain any spaces or commas.  Suffixes of G (gigabytes) and M "
"(megabytes) are allowed.</small></p><p><small>For unlimited storage enter"
" 0 (zero)</small></p>"
msgstr ""
"<p>Kontingent für <b>%(email)s</b> festlegen?</p><p><label "
"for='users_set_quota' style='display: block; font-weight: "
"normal'>Kontingent:</label><input type='text' id='users_set_quota' "
"value='%(quota)s'></p><p><small>Kontingente dürfen keine Leerzeichen oder"
" Kommas enthalten. Suffixe G (Gigabyte) und M (Megabyte) sind "
"erlaubt.</small></p><p><small>Für unbegrenzten Speicher geben Sie 0 "
"(null) ein</small></p>"

#. Status: mt
