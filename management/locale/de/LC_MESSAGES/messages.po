#: templates/users.html:53 templates/web.html:28
msgid "Actions"
msgstr "Aktionen"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:107
msgid ""
"hostmaster@, postmaster@, admin@ and abuse@ email addresses are required "
"on some domains."
msgstr ""
"hostmaster@, postmaster@, admin@ und abuse@ E-Mail-Adressen sind für "
"einige Domains erforderlich."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:113
msgid "Edit Alias"
msgstr "Alias bearbeiten"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:127
msgid "Mail aliases API (advanced)"
msgstr "Mail aliases API (fortgeschritten)"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:129
msgid ""
"Use your box&rsquo;s mail aliases API to add and remove mail aliases from"
" the command-line or custom services you build."
msgstr ""
"Verwenden Sie Ihre Box&rsquo;s Mail-Aliases-API, um Mail-Aliase aus der "
"Befehlszeile oder den von Ihnen erstellten benutzerdefinierten Diensten "
"hinzuzufügen und zu entfernen."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:131 templates/custom-dns.html:113
#: templates/users.html:107
msgid "Usage:"
msgstr "Verwendung:"

#. Status: mt
#. Phase: 1
#: templates/aliases.html:135 templates/users.html:111
msgid ""
"Brackets denote an optional argument. Please note that the POST body "
"<code>parameters</code> must be URL-encoded."
msgstr ""
"Brackets bezeichnen ein optionales Argument. Bitte beachten Sie, dass der"
" POST-Body <code> parameters</code> URL-codiert sein muss."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:137 templates/users.html:113
msgid ""
"The email and password given to the <code>--user</code> option must be an"
" administrative user on this system."
msgstr ""
"Die E-Mail und das Passwort für die Option <code>--user</code> müssen ein"
" administrativer Benutzer auf diesem System sein."

#. Status: mt
#. Phase: 1
#: templates/aliases.html:139 templates/custom-dns.html:119
#: templates/users.html:115
msgid "Verbs"
msgstr "Verben"

#. Status: mt
#. Phase: 1
