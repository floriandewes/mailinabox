#, python-format
msgid ""
"Connection to dbl.spamhaus.org timed out. Could not determine whether the"
" domain %(domain)s is blacklisted. Please try again later."
msgstr ""
"Tiempo de espera agotado al conectar con dbl.spamhaus.org. No se pudo "
"determinar si el dominio %(domain)s está en la lista negra. Inténtelo de "
"nuevo más tarde."

#. Status: mt
#. Phase: 1
#: status_checks.py:814
#, python-format
msgid ""
"Could not connect to dbl.spamhaus.org. Could not determine whether the "
"domain %(domain)s is blacklisted. Please try again later."
msgstr ""
"No se pudo conectar con dbl.spamhaus.org. No se pudo determinar si el "
"dominio %(domain)s está en la lista negra. Inténtelo de nuevo más tarde."

#. Status: mt
#. Phase: 1
#: status_checks.py:816
#, python-format
msgid ""
"Incorrect spamhaus query: %(query)s. Could not determine whether the "
"domain %(domain)s is blacklisted."
msgstr ""
"Consulta spamhaus incorrecta: %(query)s. No se pudo determinar si el "
"dominio %(domain)s está en la lista negra."

#. Status: mt
#. Phase: 1
#: status_checks.py:818
#, python-format
msgid ""
"Trixie Mail is configured to use a public DNS server. This is not "
"supported by spamhaus. Could not determine whether the domain %(domain)s "
"is blacklisted."
msgstr ""
"Trixie Mail está configurado para usar un servidor DNS público. Esto no "
"es compatible con spamhaus. No se pudo determinar si el dominio "
"%(domain)s está en la lista negra."

#. Status: mt
#. Phase: 1
#: status_checks.py:820
#, python-format
msgid ""
"Too many queries have been performed on the spamhaus server. Could not "
"determine whether the domain %(domain)s is blacklisted."
msgstr ""
"Se han realizado demasiadas consultas al servidor spamhaus. No se pudo "
"determinar si el dominio %(domain)s está en la lista negra."

#. Status: mt
#. Phase: 1
#: status_checks.py:822
#, python-format
msgid ""
"This domain is listed in the Spamhaus Domain Block List (code %(code)s),\n"
"\t\t\twhich may prevent recipients from receiving your mail.\n"
"\t\t\tSee http://www.spamhaus.org/dbl/ and "
"http://www.spamhaus.org/query/domain/%(domain)s."
msgstr ""
"Este dominio figura en la Spamhaus Domain Block List (código %(code)s),\n"
"\t\t\tlo que puede impedir que los destinatarios reciban su correo.\n"
"\t\t\tConsulte http://www.spamhaus.org/dbl/ y "
"http://www.spamhaus.org/query/domain/%(domain)s."

#. Status: mt
#. Phase: 1
#: status_checks.py:838
#, python-format
msgid ""
"This domain should resolve to this box's IP address (%(rtype)s "
"%(expected)s) if you would like the box to serve\n"
"\t\t\t\t\twebmail or a website on this domain. The domain currently "
"resolves to %(value)s in public DNS. It may take several hours for\n"
"\t\t\t\t\tpublic DNS to update after a change. This problem may result "
"from other issues listed here."
msgstr ""
"Este dominio debería resolver a la dirección IP de este sistema "
"(%(rtype)s %(expected)s) si desea que el sistema sirva\n"
"\t\t\t\t\twebmail o un sitio web en este dominio. El dominio actualmente "
"resuelve a %(value)s en el DNS público. Puede tardar varias horas en\n"
"\t\t\t\t\tactualizarse el DNS público tras un cambio. Este problema puede"
" deberse a otros problemas listados aquí."

#. Status: mt
#. Phase: 1
#: status_checks.py:844
#, python-format
msgid "Domain resolves to this box's IP address. [%(domain)s ↦ %(ips)s]"
msgstr ""
"El dominio resuelve a la dirección IP de este sistema. [%(domain)s ↦ "
"%(ips)s]"

#. Status: mt
#. Phase: 1
#: status_checks.py:912
